{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.schema.json",
  "title": "CUMCM experiment specification",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifactBase"}],
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "kind": {"const": "experiment"},
    "id": {"$ref": "common.schema.json#/$defs/typedId"},
    "revision": {"type": "integer"},
    "lifecycle_status": {"$ref": "common.schema.json#/$defs/lifecycleStatus"},
    "depends_on": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/typedId"}},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "extensions": {"type": "object"},
    "model_ref": {"$ref": "common.schema.json#/$defs/typedId"},
    "question_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/typedId"}, "uniqueItems": true},
    "mode": {"type": "string", "enum": ["exploratory", "confirmatory", "validation"]},
    "purpose": {"type": "string", "minLength": 1},
    "hypothesis": {"type": ["string", "null"]},
    "data_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/typedId"}, "uniqueItems": true},
    "code_files": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileRef"}},
    "environment": {"$ref": "common.schema.json#/$defs/fileRef"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "common.schema.json#/$defs/relativePath"},
        "environment_allowlist": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}, "uniqueItems": true},
        "network_access": {"type": "string", "enum": ["not_needed", "required", "unknown"]}
      },
      "required": ["argv", "cwd", "environment_allowlist", "network_access"]
    },
    "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}, "uniqueItems": true},
    "repetitions": {"type": "integer", "minimum": 1},
    "parameters": {"type": "object"},
    "split_strategy": {"type": "string", "minLength": 1},
    "baseline_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/typedId"}, "uniqueItems": true},
    "baseline_comparison_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "check_ref": {"$ref": "common.schema.json#/$defs/typedId"},
          "baseline_model_ref": {"$ref": "common.schema.json#/$defs/typedId"},
          "primary_metric_ref": {"$ref": "common.schema.json#/$defs/typedId"},
          "delta_definition": {"const": "primary_minus_baseline"},
          "operator": {"type": "string", "enum": ["==", "!=", "<", "<=", ">", ">="]},
          "threshold": {"type": "number"},
          "unit": {"$ref": "common.schema.json#/$defs/nonBlankString"},
          "rationale": {"$ref": "common.schema.json#/$defs/nonBlankString"}
        },
        "required": ["id", "check_ref", "baseline_model_ref", "primary_metric_ref", "delta_definition", "operator", "threshold", "unit", "rationale"]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "name": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "enum": ["minimize", "maximize", "target", "descriptive"]},
          "unit": {"$ref": "common.schema.json#/$defs/nonBlankString"},
          "aggregation": {"type": "string", "minLength": 1},
          "source_output_ref": {"$ref": "common.schema.json#/$defs/typedId"},
          "extractor": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {"const": "json_pointer"},
                  "pointer": {"type": "string", "pattern": "^(?:|/.*)$"}
                },
                "required": ["type", "pointer"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {"const": "yaml_pointer"},
                  "pointer": {"type": "string", "pattern": "^(?:|/.*)$"}
                },
                "required": ["type", "pointer"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {"const": "csv_cell"},
                  "row_index": {"type": "integer", "minimum": 0},
                  "column": {"type": "string", "minLength": 1}
                },
                "required": ["type", "row_index", "column"]
              }
            ]
          }
        },
        "required": ["id", "name", "direction", "unit", "aggregation", "source_output_ref", "extractor"]
      }
    },
    "acceptance_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric_ref": {"$ref": "common.schema.json#/$defs/typedId"},
          "operator": {"type": "string", "enum": ["==", "!=", "<", "<=", ">", ">="]},
          "threshold": {"type": "number"},
          "unit": {"$ref": "common.schema.json#/$defs/nonBlankString"},
          "registration_timing": {"type": "string", "enum": ["pre_result", "post_result"]},
          "rationale": {"$ref": "common.schema.json#/$defs/nonBlankString"}
        },
        "required": ["metric_ref", "operator", "threshold", "unit", "registration_timing", "rationale"]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "required": {"type": "boolean"},
          "comparator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {"type": "string", "enum": ["exact_sha256", "json_numeric", "csv_numeric", "existence"]},
              "expected_sha256": {
                "oneOf": [
                  {"$ref": "common.schema.json#/$defs/sha256"},
                  {"type": "null"}
                ]
              },
              "reference_file": {
                "oneOf": [
                  {"$ref": "common.schema.json#/$defs/fileRef"},
                  {"type": "null"}
                ]
              },
              "absolute_tolerance": {"type": "number", "minimum": 0},
              "relative_tolerance": {"type": "number", "minimum": 0},
              "key_columns": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "required": ["type", "expected_sha256", "reference_file"],
            "allOf": [
              {
                "if": {"properties": {"type": {"const": "exact_sha256"}}, "required": ["type"]},
                "then": {
                  "properties": {
                    "expected_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                    "reference_file": {"type": "null"}
                  }
                }
              },
              {
                "if": {"properties": {"type": {"enum": ["json_numeric", "csv_numeric"]}}, "required": ["type"]},
                "then": {
                  "properties": {
                    "expected_sha256": {"type": "null"},
                    "reference_file": {"$ref": "common.schema.json#/$defs/fileRef"}
                  },
                  "required": ["absolute_tolerance", "relative_tolerance"]
                }
              },
              {
                "if": {"properties": {"type": {"const": "existence"}}, "required": ["type"]},
                "then": {
                  "properties": {
                    "expected_sha256": {"type": "null"},
                    "reference_file": {"type": "null"}
                  }
                }
              }
            ]
          }
        },
        "required": ["id", "path", "required", "comparator"]
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "resource_note": {"type": "string", "minLength": 1}
  },
  "required": ["model_ref", "question_refs", "mode", "purpose", "hypothesis", "data_refs", "code_files", "environment", "command", "seeds", "repetitions", "parameters", "split_strategy", "baseline_refs", "baseline_comparison_rules", "metrics", "acceptance_rules", "outputs", "timeout_seconds", "resource_note"],
  "unevaluatedProperties": false
}
