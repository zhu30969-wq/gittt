{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_build.schema.json",
  "title": "CUMCM paper build receipt",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/artifactBase"},
    {
      "if": {"properties": {"engine": {"const": "latex"}}, "required": ["engine"]},
      "then": {"properties": {"dependency_log": {"$ref": "common.schema.json#/$defs/fileRef"}}},
      "else": {"properties": {"dependency_log": {"type": "null"}}}
    }
  ],
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "kind": {"const": "paper_build"},
    "id": {"$ref": "common.schema.json#/$defs/typedId"},
    "revision": {"type": "integer"},
    "lifecycle_status": {"$ref": "common.schema.json#/$defs/lifecycleStatus"},
    "depends_on": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/typedId"}},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "extensions": {"type": "object"},
    "source_entrypoint": {"$ref": "common.schema.json#/$defs/fileRef"},
    "fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "common.schema.json#/$defs/sha256"},
      "propertyNames": {"$ref": "common.schema.json#/$defs/typedId"}
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/fileRef"},
      "uniqueItems": true
    },
    "resource_files": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/fileRef"},
      "uniqueItems": true
    },
    "competition_profile": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile_ref": {"$ref": "common.schema.json#/$defs/typedId"},
            "path": {"$ref": "common.schema.json#/$defs/relativePath"},
            "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
          },
          "required": ["profile_ref", "path", "sha256"]
        }
      ]
    },
    "engine": {"type": "string", "enum": ["latex", "typst"]},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "required": ["name", "version"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "common.schema.json#/$defs/relativePath"},
        "output_path": {"$ref": "common.schema.json#/$defs/relativePath"}
      },
      "required": ["argv", "cwd", "output_path"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "exit_code": {"const": 0},
    "log": {"$ref": "common.schema.json#/$defs/fileRef"},
    "dependency_log": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/fileRef"}
      ]
    },
    "pdf": {"$ref": "common.schema.json#/$defs/fileRef"}
  },
  "required": [
    "source_entrypoint",
    "fingerprints",
    "source_files",
    "resource_files",
    "competition_profile",
    "engine",
    "compiler",
    "command",
    "started_at",
    "finished_at",
    "exit_code",
    "log",
    "dependency_log",
    "pdf"
  ],
  "unevaluatedProperties": false
}
