{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem_spec.schema.json",
  "title": "CUMCM problem specification",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifactBase"}],
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "kind": {"const": "problem_spec"},
    "id": {"$ref": "common.schema.json#/$defs/typedId"},
    "revision": {"type": "integer"},
    "lifecycle_status": {"$ref": "common.schema.json#/$defs/lifecycleStatus"},
    "depends_on": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/typedId"}},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "extensions": {"type": "object"},
    "contest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1992},
        "problem_code": {"type": "string", "minLength": 1},
        "rules": {"$ref": "common.schema.json#/$defs/fileRef"},
        "format_profile": {"$ref": "common.schema.json#/$defs/relativePath"}
      },
      "required": ["name", "year", "problem_code"]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1}
      },
      "required": ["path", "sha256", "language"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "text": {"type": "string", "minLength": 1},
          "task_type": {
            "type": "string",
            "enum": ["description", "prediction", "evaluation", "optimization", "mechanism", "decision", "other"]
          },
          "required_outputs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "common.schema.json#/$defs/typedId"},
            "uniqueItems": true
          },
          "evaluation_intent": {"type": "string", "minLength": 1}
        },
        "required": ["id", "text", "task_type", "required_outputs", "evaluation_intent"]
      }
    },
    "data_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "availability": {"type": "string", "enum": ["bundled", "external", "generated"]},
          "role": {
            "type": "string",
            "enum": ["raw_data", "result_template", "instruction", "reference", "generated_intermediate", "other"]
          },
          "classification_basis": {
            "type": "string",
            "enum": ["declared", "content_inspected", "filename_heuristic", "human_confirmed"]
          },
          "usable_for_modeling": {"type": "boolean"},
          "immutable_raw": {"type": "boolean"},
          "intended_use": {"type": "string", "minLength": 1},
          "question_refs": {
            "type": "array",
            "items": {"$ref": "common.schema.json#/$defs/typedId"},
            "uniqueItems": true
          },
          "exclusion_reason": {"type": ["string", "null"], "minLength": 1},
          "file": {"$ref": "common.schema.json#/$defs/fileRef"},
          "producer_ref": {
            "oneOf": [
              {"$ref": "common.schema.json#/$defs/typedId"},
              {"type": "null"}
            ]
          },
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "definition": {"type": "string", "minLength": 1},
                "unit": {"$ref": "common.schema.json#/$defs/nonBlankString"}
              },
              "required": ["name", "definition", "unit"]
            }
          }
        },
        "required": [
          "id",
          "availability",
          "role",
          "classification_basis",
          "usable_for_modeling",
          "immutable_raw",
          "intended_use",
          "question_refs",
          "exclusion_reason",
          "source",
          "license"
        ],
        "allOf": [
          {
            "if": {"properties": {"availability": {"const": "bundled"}}},
            "then": {"required": ["file"]}
          },
          {
            "if": {"properties": {"usable_for_modeling": {"const": false}}, "required": ["usable_for_modeling"]},
            "then": {"properties": {"exclusion_reason": {"type": "string", "minLength": 1}}}
          },
          {
            "if": {"properties": {"usable_for_modeling": {"const": true}}, "required": ["usable_for_modeling"]},
            "then": {
              "properties": {"exclusion_reason": {"type": "null"}, "question_refs": {"minItems": 1}},
              "required": ["file"]
            }
          },
          {
            "if": {
              "properties": {
                "usable_for_modeling": {"const": true},
                "role": {"const": "generated_intermediate"}
              },
              "required": ["usable_for_modeling", "role"]
            },
            "then": {
              "properties": {
                "availability": {"const": "generated"},
                "producer_ref": {"$ref": "common.schema.json#/$defs/typedId"}
              },
              "required": ["producer_ref"]
            }
          },
          {
            "if": {
              "properties": {
                "usable_for_modeling": {"const": true},
                "availability": {"const": "generated"}
              },
              "required": ["usable_for_modeling", "availability"]
            },
            "then": {
              "properties": {
                "role": {"const": "generated_intermediate"},
                "producer_ref": {"$ref": "common.schema.json#/$defs/typedId"}
              },
              "required": ["producer_ref"]
            }
          },
          {
            "if": {
              "properties": {
                "usable_for_modeling": {"const": true},
                "role": {"const": "raw_data"}
              },
              "required": ["usable_for_modeling", "role"]
            },
            "then": {"properties": {"availability": {"enum": ["bundled", "external"]}}}
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "text": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "enum": ["given", "inferred", "simplifying"]},
          "impact": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1}
        },
        "required": ["id", "text", "basis", "impact", "check"]
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "text": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "status": {"type": "string", "enum": ["open", "resolved", "branched"]},
          "handling": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        },
        "required": ["id", "text", "severity", "status", "handling", "impact"]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "text": {"type": "string", "minLength": 1},
          "hard": {"type": "boolean"},
          "question_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "common.schema.json#/$defs/typedId"},
            "uniqueItems": true
          }
        },
        "required": ["id", "text", "hard", "question_refs"]
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/typedId"},
          "description": {"type": "string", "minLength": 1},
          "question_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "common.schema.json#/$defs/typedId"}
          }
        },
        "required": ["id", "description", "question_refs"]
      }
    },
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "required": ["contest", "statement", "questions", "data_assets", "assumptions", "ambiguities", "constraints", "deliverables", "out_of_scope"],
  "unevaluatedProperties": false
}
